#!/usr/bin/env bash
# End-to-end test of the Comfier agent against the real app: Puma, Sidekiq (with cron), Redis and
# Postgres, a fake ComfyUI, and the real agent (python -m comfier_agent).
#
# 1. A generation with an input image runs through the agent and succeeds with its output.
# 2. The agent is killed mid-job and restarted; the job is recovered and completes exactly once.
#
# Needs Postgres (POSTGRES_* as for the test suite), Redis, and a Python with the agent installed
# (pip install -e comfyui/comfier_agent). Uses its own Redis database and resets the test database.
set -euo pipefail
cd "$(dirname "$0")/.."

export RAILS_ENV=test
export AGENT_STORE=redis
export ACTIVE_JOB_QUEUE_ADAPTER=sidekiq
export REDIS_URL="${E2E_REDIS_URL:-redis://localhost:6379/15}"
PORT="${E2E_PORT:-3100}"
COMFY_PORT="${E2E_COMFY_PORT:-8199}"
PYTHON="${PYTHON:-python3}"
export APP_URL="http://127.0.0.1:${PORT}"
LOGS=tmp/e2e
PIDS=()
AGENT_PID=""

mkdir -p "$LOGS"
rm -f "$LOGS"/*.log

cleanup() {
  status=$?
  for pid in "${PIDS[@]}" $AGENT_PID; do kill "$pid" 2>/dev/null || true; done
  wait 2>/dev/null || true
  if [ "$status" -ne 0 ]; then
    for log in "$LOGS"/*.log; do
      echo "===== $log (last 60 lines)"
      tail -n 60 "$log"
    done
  fi
  exit "$status"
}
trap cleanup EXIT

runner() { bin/rails runner test/e2e/agent_e2e.rb "$@"; }

wait_for_http() {
  for _ in $(seq 1 120); do
    curl -fsS "$1" >/dev/null 2>&1 && return 0
    sleep 0.5
  done
  echo "timed out waiting for $1" >&2
  return 1
}

comfy_execute_seconds() {
  curl -fsS -X POST -H 'Content-Type: application/json' -d "{\"seconds\": $1}" \
    "http://127.0.0.1:${COMFY_PORT}/_e2e/execute_seconds" >/dev/null
}

start_agent() {
  COMFIER_URL="$APP_URL" COMFIER_API_KEY="$KEY" COMFIER_ALLOW_INSECURE=true COMFIER_BACKEND_NAME="E2E box" \
    COMFIER_COMFYUI_URL="http://127.0.0.1:${COMFY_PORT}" COMFIER_INPUT_DIR="$LOGS/comfy-input" \
    COMFIER_OUTPUT_DIR="$LOGS/comfy-output" COMFIER_HEARTBEAT_SECONDS=2 PYTHONUNBUFFERED=1 \
    "$PYTHON" -m comfier_agent >>"$LOGS/agent.log" 2>&1 &
  AGENT_PID=$!
}

echo "--- preparing the database and Redis"
bin/rails db:test:prepare
bin/rails runner 'Redis.new(url: ENV.fetch("REDIS_URL")).flushdb'
mkdir -p "$LOGS/comfy-input" "$LOGS/comfy-output"
KEY="$(runner seed | tail -n 1)"

echo "--- starting fake ComfyUI, Puma and Sidekiq"
"$PYTHON" test/e2e/fake_comfyui.py --port "$COMFY_PORT" --execute-seconds 1 >"$LOGS/comfy.log" 2>&1 &
PIDS+=($!)
bin/rails server -b 127.0.0.1 -p "$PORT" -P "$LOGS/puma.pid" >"$LOGS/puma.log" 2>&1 &
PIDS+=($!)
bundle exec sidekiq -C config/sidekiq.yml >"$LOGS/sidekiq.log" 2>&1 &
PIDS+=($!)
wait_for_http "http://127.0.0.1:${COMFY_PORT}/system_stats"
wait_for_http "${APP_URL}/up"

echo "--- starting the agent"
start_agent

echo "--- 1. a job runs and succeeds"
GEN="$(runner submit | tail -n 1)"
runner wait "$GEN" completed 90
runner check "$GEN"

echo "--- 2. the agent is killed mid-job and restarted"
comfy_execute_seconds 8
GEN="$(runner submit | tail -n 1)"
runner wait "$GEN" running 60
kill -9 "$AGENT_PID"
wait "$AGENT_PID" 2>/dev/null || true
comfy_execute_seconds 1
start_agent
runner wait "$GEN" completed 120
runner check "$GEN" --recovered

echo "--- agent end-to-end test passed"
