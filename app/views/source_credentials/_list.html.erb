<% if credentials.any? %>
  <table class="table table-compact align-middle mb-4">
    <thead><tr><th>Site</th><th>Label</th><th>Token</th><th class="text-12">Updated</th><th></th></tr></thead>
    <tbody>
      <% credentials.each do |credential| %>
        <tr>
          <td class="fw-medium"><%= credential.host %></td>
          <td class="text-12 text-secondary"><%= credential.label.presence || '—' %></td>
          <td><code class="text-12">…<%= credential.last4 %></code></td>
          <td class="text-12 text-secondary"><%= friendly_time(credential.updated_at) %></td>
          <td class="text-end">
            <div class="dropdown d-inline">
              <button class="btn btn-sm btn-link text-secondary" type="button" data-bs-toggle="dropdown"
                      aria-expanded="false" aria-label="More actions for <%= credential.host %>">
                <i class="bi bi-three-dots" aria-hidden="true"></i>
              </button>
              <ul class="dropdown-menu dropdown-menu-end text-13">
                <li>
                  <%= button_to 'Delete', delete_path.call(credential), method: :delete, class: 'dropdown-item text-danger',
                                form: { data: { turbo_confirm: "Delete the token for #{credential.host}?" } } %>
                </li>
              </ul>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<div class="h-section-label">Add or replace a token</div>
<%= form_with model: credential, url: create_path, scope: :source_credential, class: 'settings-form' do |f| %>
  <% if credential.errors.any? %>
    <div class="alert alert-danger py-2 text-13"><%= credential.errors.full_messages.to_sentence %></div>
  <% end %>
  <div class="row g-2">
    <div class="col-md-4">
      <%= f.label :host, 'Site', class: 'form-label' %>
      <%= f.text_field :host, class: 'form-control form-control-sm', placeholder: 'huggingface.co', required: true %>
    </div>
    <div class="col-md-4">
      <%= f.label :secret, 'Token', class: 'form-label' %>
      <%= f.password_field :secret, class: 'form-control form-control-sm', required: true, autocomplete: 'off',
                                    value: nil %>
    </div>
    <div class="col-md-4">
      <%= f.label :label, class: 'form-label' %>
      <%= f.text_field :label, class: 'form-control form-control-sm', placeholder: 'Read-only token' %>
    </div>
  </div>
  <div class="form-text text-12 mb-2">
    Sent only with downloads from this site and its subdomains. You won't be able to see it again after saving.
  </div>
  <%= f.submit 'Save token', class: 'btn btn-primary btn-sm' %>
<% end %>
