<div class="sidebar-card mt-3">
  <div class="h-section-label">Keys</div>
  <ul class="list-unstyled text-12 mb-2">
    <% keys.first(5).each do |key| %>
      <li class="d-flex justify-content-between align-items-center mb-1">
        <span>
          <code><%= key.display %></code>
          <% if key.revoked? %><span class="text-secondary">revoked</span>
          <% elsif key.expired? %><span class="text-secondary">expired</span>
          <% elsif key.expires_at %><span class="text-warning">expires <%= friendly_time(key.expires_at) %></span>
          <% end %>
          <% if key.last_used_at %><div class="text-secondary">used <%= friendly_time(key.last_used_at) %></div><% end %>
        </span>
        <% if key.usable? %>
          <%= button_to 'Revoke', server_key_path(backend, key), method: :delete, class: 'btn btn-link btn-sm text-danger p-0',
                        form: { data: { turbo_confirm: 'Revoke this key? A server using it disconnects now.' } } %>
        <% end %>
      </li>
    <% end %>
  </ul>
  <%= form_with url: rotate_server_keys_path(backend), data: { turbo: false } do %>
    <div class="form-check text-12 mb-2">
      <%= check_box_tag :revoke_immediately, '1', false, class: 'form-check-input' %>
      <%= label_tag :revoke_immediately, 'Stop the old key working now (otherwise it works for 24 hours)', class: 'form-check-label' %>
    </div>
    <%= submit_tag 'New key', class: 'btn btn-outline-secondary btn-sm' %>
  <% end %>
</div>
