<% content_for :title, @backend.name %>

<div class="text-12 text-secondary mb-2"><%= link_to 'Backends', admin_backends_path, class: 'link-secondary' %> /</div>
<div class="d-flex align-items-center gap-2 mb-3">
  <h1 class="h-page-title mb-0"><%= @backend.name %></h1>
  <%= backend_status_dot(@backend) %>
</div>

<% if @backend.legacy? %>
  <div class="status-panel status-attention mb-3 d-flex justify-content-between align-items-center gap-3">
    <div class="text-13">
      <div class="fw-medium">Switch to the Comfier Agent</div>
      <div class="text-secondary">The agent connects out to Comfier, so ComfyUI needn't be reachable, and it can download any model and report progress.</div>
    </div>
    <%= button_to 'Switch', convert_admin_backend_path(@backend), class: 'btn btn-outline-secondary btn-sm',
                  form: { data: { turbo: false, turbo_confirm: "Switch #{@backend.name} to the agent? Its history is kept." } } %>
  </div>
<% end %>

<%= render 'form', backend: @backend %>

<div class="text-12 text-secondary mt-5">
  <div class="h-section-label">System</div>
  <div>Last checked <%= friendly_time(@backend.last_checked_at).presence || 'never' %>
    <% if @backend.last_check_message %> · <%= @backend.last_check_message %><% end %></div>
  <div>Added <%= friendly_time(@backend.created_at) %> · updated <%= friendly_time(@backend.updated_at) %></div>
</div>
