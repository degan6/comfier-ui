<% content_for :title, 'Log entry' %>

<div class="mb-3">
  <%= link_to admin_activity_logs_path, class: 'text-12 text-secondary text-decoration-none' do %>
    <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Back to log
  <% end %>
</div>

<div class="d-flex align-items-start justify-content-between mb-3 gap-3">
  <div>
    <h1 class="h-page-title mb-2">Log entry</h1>
    <div class="text-13 text-secondary">
      <%= friendly_time(@activity_log.created_at) %>
      <% if @activity_log.ip_address.present? %>
        · <span class="font-monospace"><%= @activity_log.ip_address %></span>
      <% end %>
    </div>
  </div>
  <%= activity_log_kind_badge(@activity_log) %>
</div>

<div class="profile-field-group mb-4">
  <div class="h-section-label">Summary</div>
  <p class="text-13 mb-2"><%= @activity_log.message %></p>
  <% if @activity_log.user %>
    <div class="text-12 text-secondary">
      User · <span class="text-body"><%= @activity_log.user.display_name %></span>
      <% if @activity_log.user.email.present? %>
        · <%= @activity_log.user.email %>
      <% end %>
    </div>
  <% end %>
  <% if @activity_log.subject %>
    <div class="text-12 text-secondary mt-1">
      Subject · <%= @activity_log.subject_type %> #<%= @activity_log.subject_id %>
    </div>
  <% end %>
  <% if @activity_log.user_agent.present? %>
    <div class="text-12 text-secondary mt-2"><%= @activity_log.user_agent %></div>
  <% end %>
</div>

<div class="profile-field-group">
  <div class="h-section-label">Details</div>
  <pre class="text-12 mb-0 p-3 rounded border bg-body-tertiary" style="max-height: 70vh; overflow: auto;"><%= activity_log_details_json(@activity_log) %></pre>
</div>
